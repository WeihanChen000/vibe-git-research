name: Research collaboration checks
on:
  push:
    branches: [codex/research-team-share]
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  research:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: vibe-git
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
          cache-dependency-path: vibe-git/package-lock.json
      - run: npm ci
      - run: npm run build
      - run: npm run test:sciencepal
      - run: npm run test:research-share
