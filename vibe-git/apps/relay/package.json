{
  "name": "@vibe-git/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vibe-git/protocol": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  },
  "exports": {
    "./agent-registry": {
      "types": "./dist/agent-registry.d.ts",
      "import": "./dist/agent-registry.js"
    },
    "./agent-executor": {
      "types": "./dist/agent-executor.d.ts",
      "import": "./dist/agent-executor.js"
    },
    "./agent-types": {
      "types": "./dist/agent-types.d.ts",
      "import": "./dist/agent-types.js"
    }
  }
}
